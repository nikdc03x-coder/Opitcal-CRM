//
// Optical CRM — PostgreSQL Database
//
// Stores customer information, optical prescriptions,
// purchase history, and admin-managed product catalogs.
//
// nik - Keep catalogs independent of historical purchases
// so changing a product never changes old customer records.
//

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

// -----------------------------------------------------
// 1. PRICING MODE
// -----------------------------------------------------

// The shop can enter frame and lens rates separately
// or enter only the final MRP.
enum PricingMode {
  SPLIT
  MRP_ONLY
}

// -----------------------------------------------------
// 2. SHOP
// -----------------------------------------------------

// Each shop has separate customers and catalogs.
// Admin authentication and shop selection will be
// implemented in a later phase.
model Shop {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customers    Customer[]
  frameCatalog FrameCatalog[]
  lensCatalog  LensCatalog[]
}

// -----------------------------------------------------
// 3. CUSTOMER
// -----------------------------------------------------

// Stores customer personal information.
// Purchase and prescription histories are separate.
model Customer {
  id        String  @id @default(uuid())
  shopId    String
  name      String
  mobNumber String?
  gender    String?
  reference String?
  notes     String? @db.Text
  isActive  Boolean @default(true)

  // Preserve original MongoDB IDs for future migration.
  legacyMongoId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shop          Shop             @relation(fields: [shopId], references: [id])
  prescriptions Prescription[]
  records       CustomerRecord[]

  @@unique([shopId, legacyMongoId])
  // Multiple customers may share the same phone number.
  @@index([shopId, mobNumber])
  @@index([shopId, name])
}

// -----------------------------------------------------
// 4. PRESCRIPTION HISTORY
// -----------------------------------------------------

// Every customer may have multiple prescriptions.
model Prescription {
  id         String   @id @default(uuid())
  customerId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // RIGHT EYE — DISTANCE
  reDistSph  Decimal? @db.Decimal(5, 2)
  reDistCyl  Decimal? @db.Decimal(5, 2)
  reDistAxis Int?

  // RIGHT EYE — NEAR
  reNearSph  Decimal? @db.Decimal(5, 2)
  reNearCyl  Decimal? @db.Decimal(5, 2)
  reNearAxis Int?

  // LEFT EYE — DISTANCE
  leDistSph  Decimal? @db.Decimal(5, 2)
  leDistCyl  Decimal? @db.Decimal(5, 2)
  leDistAxis Int?

  // LEFT EYE — NEAR
  leNearSph  Decimal? @db.Decimal(5, 2)
  leNearCyl  Decimal? @db.Decimal(5, 2)
  leNearAxis Int?

  customer Customer         @relation(fields: [customerId], references: [id])
  records  CustomerRecord[]

  @@index([customerId, createdAt])
}

// -----------------------------------------------------
// 5. FRAME CATALOG — ADMIN MANAGED
// -----------------------------------------------------

// Admins can add and edit frames through the webpage.
// Each frame belongs to one shop.
model FrameCatalog {
  id     String @id @default(uuid())
  shopId String

  // Example:
  // Brand: Titan Eye+
  // Model: TF-204
  // Code: TIT-TF204
  // Style: Full Rim
  brand      String  @db.VarChar(150)
  model      String  @db.VarChar(150)
  frameCode  String? @db.VarChar(100)
  frameStyle String? @db.VarChar(100)

  // Additional information about the product.
  description String? @db.Text

  // Inactive frames cannot be selected for new purchases.
  // Historical purchases remain unchanged.
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shop    Shop             @relation(fields: [shopId], references: [id])
  records CustomerRecord[]

  @@index([shopId, isActive, brand])
  @@index([shopId, model])
}

// -----------------------------------------------------
// 6. LENS CATALOG — ADMIN MANAGED
// -----------------------------------------------------

// Admins can manage lens products without editing code.
model LensCatalog {
  id     String @id @default(uuid())
  shopId String

  // Example:
  // Company: ZEISS
  // Lens Name: SmartLife
  // Vision Type: Progressive
  // Coating: Anti-Reflective
  company    String  @db.VarChar(150)
  lensName   String  @db.VarChar(150)
  visionType String  @db.VarChar(100)
  coating    String? @db.VarChar(200)

  // Optional product code.
  lensCode String? @db.VarChar(100)

  // Additional material, coating or product information.
  description String? @db.Text

  // Deactivated lenses stay in historical purchases.
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shop    Shop             @relation(fields: [shopId], references: [id])
  records CustomerRecord[]

  @@index([shopId, isActive, company])
  @@index([shopId, lensName])
  @@index([shopId, visionType])
}

// -----------------------------------------------------
// 7. CUSTOMER PURCHASE HISTORY
// -----------------------------------------------------

// Customers can have multiple purchases.
// Existing purchases are preserved during catalog setup.
model CustomerRecord {
  id             String  @id @default(uuid())
  customerId     String
  prescriptionId String?

  // Original product descriptions are retained.
  //
  // New purchases can store a snapshot of the selected
  // catalog product's description here.
  //
  // Example:
  // specsType = "Titan Eye+ — TF-204 (Full Rim)"
  // lensType  = "ZEISS — SmartLife | Progressive | AR"
  specsType String?
  lensType  String?

  // Optional references to the selected catalog items.
  // Existing customer purchases keep null values.
  frameCatalogId String?
  lensCatalogId  String?

  // Pricing is saved separately for each purchase.
  pricingMode PricingMode @default(MRP_ONLY)

  frameRate Decimal? @db.Decimal(12, 2)
  lensRate  Decimal? @db.Decimal(12, 2)
  mrp       Decimal  @db.Decimal(12, 2)

  // MongoDB migration compatibility.
  legacyMongoId String?

  // The actual date of purchase.
  // Null means the date was not recorded.
  purchaseDate DateTime? @db.Date

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ---------------------------------------------------
  // RELATIONSHIPS
  // ---------------------------------------------------

  // Prisma relationship attributes must be written
  // on one line to avoid P1012 syntax errors.
  customer     Customer      @relation(fields: [customerId], references: [id])
  prescription Prescription? @relation(fields: [prescriptionId], references: [id])

  // Optional product references do not force existing
  // customer records to have catalog products.
  frameCatalog FrameCatalog? @relation(fields: [frameCatalogId], references: [id], onDelete: SetNull)
  lensCatalog  LensCatalog?  @relation(fields: [lensCatalogId], references: [id], onDelete: SetNull)

  // ---------------------------------------------------
  // INDEXES
  // ---------------------------------------------------

  @@unique([customerId, legacyMongoId])
  @@index([customerId, createdAt])
  @@index([frameCatalogId])
  @@index([lensCatalogId])
}

//
// Optical CRM — PostgreSQL Database
//
// Stores customers, prescriptions, purchase history,
// product catalogs, admin authentication, and order tracking.
//

generator client {
  provider            = "prisma-client"
  output              = "../generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

// 1. PRICING MODE AND ORDER STATUS

enum PricingMode {
  SPLIT
  MRP_ONLY
}

// Track each stage of a manually created order.
enum OrderStatus {
  PLACED
  PROCESSING
  READY
  DELIVERED
  CANCELLED
}

// 2. SHOP

// Each shop has its own customers and products.
model Shop {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customers    Customer[]
  frameCatalog FrameCatalog[]
  lensCatalog  LensCatalog[]

  // A shop can manage multiple spectacle orders.
  orders Order[]
}

// 3. CUSTOMER

// Personal details and staff-only notes.
model Customer {
  id        String  @id @default(uuid())
  shopId    String
  name      String
  mobNumber String?
  gender    String?
  reference String?
  notes     String? @db.Text
  isActive  Boolean @default(true)
  // Soft‑delete flag for Trash integration
  deletedAt DateTime?
  deletionGroupId String?

  // nik - Age is an optional observation, not a date of birth or a current-age estimate.
  ageAtRecording Int?
  ageRecordedAt  DateTime?

  // Preserve original MongoDB IDs.
  legacyMongoId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shop          Shop             @relation(fields: [shopId], references: [id])
  prescriptions Prescription[]
  records       CustomerRecord[]

  // Customer orders are separate from purchase history.
  orders Order[]

  @@unique([shopId, legacyMongoId])
  // Multiple customers can share a phone number.
  @@index([shopId, mobNumber])
  @@index([shopId, name])
}

// 4. PRESCRIPTION HISTORY

// Each customer can have multiple prescriptions.
model Prescription {
  // Null for historical or independently created prescriptions. Never infer provenance.
  createdForPurchaseId String? @unique
  deletedAt DateTime?
  deletionGroupId String?
  @@index([deletionGroupId])
  id         String   @id @default(uuid())
  customerId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // RIGHT EYE — DISTANCE
  reDistSph  Decimal? @db.Decimal(5, 2)
  reDistCyl  Decimal? @db.Decimal(5, 2)
  reDistAxis Int?

  // RIGHT EYE — NEAR
  reNearSph  Decimal? @db.Decimal(5, 2)
  reNearCyl  Decimal? @db.Decimal(5, 2)
  reNearAxis Int?

  // LEFT EYE — DISTANCE
  leDistSph  Decimal? @db.Decimal(5, 2)
  leDistCyl  Decimal? @db.Decimal(5, 2)
  leDistAxis Int?

  // LEFT EYE — NEAR
  leNearSph  Decimal? @db.Decimal(5, 2)
  leNearCyl  Decimal? @db.Decimal(5, 2)
  leNearAxis Int?

  customer Customer         @relation(fields: [customerId], references: [id])
  records  CustomerRecord[]

  @@index([customerId, createdAt])
}

// 5. FRAME CATALOG

// Catalog changes never rewrite old purchases.
model FrameCatalog {
  id     String @id @default(uuid())
  shopId String

  brand      String  @db.VarChar(150)
  model      String  @db.VarChar(150)
  frameCode  String? @db.VarChar(100)
  frameStyle String? @db.VarChar(100)

  description String? @db.Text

  // Inactive products stay in purchase history.
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shop    Shop             @relation(fields: [shopId], references: [id])
  records CustomerRecord[]

  @@index([shopId, isActive, brand])
  @@index([shopId, model])
}

// 6. LENS CATALOG

// Store lens information independently.
model LensCatalog {
  id     String @id @default(uuid())
  shopId String

  company    String  @db.VarChar(150)
  lensName   String  @db.VarChar(150)
  visionType String  @db.VarChar(100)
  coating    String? @db.VarChar(200)

  lensCode    String? @db.VarChar(100)
  description String? @db.Text

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shop    Shop             @relation(fields: [shopId], references: [id])
  records CustomerRecord[]

  @@index([shopId, isActive, company])
  @@index([shopId, lensName])
  @@index([shopId, visionType])
}

// 7. CUSTOMER PURCHASE HISTORY

// Preserve purchase prices and product snapshots.
model CustomerRecord {
  deletedAt DateTime?
  deletionGroupId String?
  @@index([deletionGroupId])
  id             String  @id @default(uuid())
  customerId     String
  prescriptionId String?

  // Actual saved product descriptions.
  specsType String?
  lensType  String?

  // Optional catalog references.
  frameCatalogId String?
  lensCatalogId  String?

  // Split pricing or final MRP.
  pricingMode PricingMode @default(MRP_ONLY)

  frameRate Decimal? @db.Decimal(12, 2)
  lensRate  Decimal? @db.Decimal(12, 2)
  mrp       Decimal? @db.Decimal(12, 2)

  // MongoDB migration compatibility.
  legacyMongoId String?

  // Actual date of purchase.
  purchaseDate DateTime? @db.Date

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships.
  customer     Customer      @relation(fields: [customerId], references: [id])
  prescription Prescription? @relation(fields: [prescriptionId], references: [id])

  frameCatalog FrameCatalog? @relation(fields: [frameCatalogId], references: [id], onDelete: SetNull)
  lensCatalog  LensCatalog?  @relation(fields: [lensCatalogId], references: [id], onDelete: SetNull)

  // A purchase can have one manually created tracking order.
  order Order?

  @@unique([customerId, legacyMongoId])
  @@index([customerId, createdAt])
  @@index([frameCatalogId])
  @@index([lensCatalogId])
}

// 8. CRM ACCOUNTS (existing admin IDs and password hashes are preserved)
enum AccountRole {
  ADMIN
  USER
}

model Admin {
  id           Int    @id @default(autoincrement())
  username     String @unique
  passwordHash String
  email        String? @unique
  name         String @default("")
  role         AccountRole @default(ADMIN)
  isActive     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions AdminSession[]
  deletionPin AdminDeletionPin?
  passwordResets PasswordResetToken[]

  @@map("admins")
}

model PasswordResetToken {
  id String @id @default(uuid())
  adminId Int
  tokenHash String @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  admin Admin @relation(fields: [adminId], references: [id], onDelete: Cascade)
  @@index([adminId])
  @@index([expiresAt])
}

// Shared email rate limits apply equally to known and unknown addresses.
model AccountRateLimit {
  key String @id
  attempts Int @default(1)
  expiresAt DateTime
  @@index([expiresAt])
}

// Separate confirmation credential. Failed attempts survive restarts and workers.
model AdminDeletionPin {
  adminId Int @id
  pinHash String
  failedAttempts Int @default(0)
  lockedUntil DateTime?
  updatedAt DateTime @updatedAt
  admin Admin @relation(fields: [adminId], references: [id], onDelete: Cascade)
}

// 9. ADMIN LOGIN SESSIONS

// Remember active admin logins securely.
// Only a hash of each session token is stored.
model AdminSession {
  id        String   @id @default(uuid())
  adminId   Int
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  admin Admin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([expiresAt])
}

// 10. SPECTACLE ORDER TRACKING

// Staff create orders manually from existing purchases.
// Normal purchases do not automatically create orders.
model Order {
  id               String @id @default(uuid())
  orderNumber      String @unique
  shopId           String
  customerId       String
  purchaseRecordId String @unique

  // New orders start as PLACED.
  status OrderStatus @default(PLACED)

  // Expected handover date and actual completion time.
  expectedDeliveryDate DateTime? @db.Date
  deliveredAt          DateTime?
  cancelledAt          DateTime?

  // Staff-only instructions, never added to customer PDFs.
  internalNotes String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Connect the order to existing CRM records.
  shop     Shop           @relation(fields: [shopId], references: [id])
  customer Customer       @relation(fields: [customerId], references: [id])
  purchase CustomerRecord @relation(fields: [purchaseRecordId], references: [id])

  // Preserve every status change for staff.
  history OrderStatusHistory[]

  @@index([shopId, status])
  @@index([shopId, expectedDeliveryDate])
  @@index([customerId, createdAt])
}

// 11. ORDER STATUS HISTORY

// Record when an order moves to another stage.
model OrderStatusHistory {
  id String @id @default(uuid())

  orderId String

  // Null is allowed for the initial order creation event.
  fromStatus OrderStatus?
  toStatus   OrderStatus

  // Optional reason for a change or cancellation.
  note String? @db.Text

  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId, createdAt])
}


PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Use the same development Neon branch for both URLs. Percent-encode credentials.
DATABASE_URL=postgresql://USER:PASSWORD@ep-YOUR-ENDPOINT-pooler.REGION.aws.neon.tech/DATABASE?sslmode=verify-full
DIRECT_URL=postgresql://USER:PASSWORD@ep-YOUR-ENDPOINT.REGION.aws.neon.tech/DATABASE?sslmode=verify-full

# Set to a random 64-character hexadecimal value, shared by all API instances.
SESSION_SECRET=
# Maximum application connections per API process (Neon PgBouncer handles backends).
DB_POOL_MAX=10
# Number of trusted reverse proxies; leave 0 for direct local development.
TRUST_PROXY_HOPS=0
